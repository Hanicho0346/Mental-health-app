NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mentalhealth
JWT_SECRET=change-me-min-16-chars-long
JWT_REFRESH_SECRET=change-me-min-16-chars-long
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_DAYS=30
CORS_ORIGINS=http://localhost:8081
# When true, register stores a 6-digit OTP and emails it; client goes to /verify-email before login.
EMAIL_VERIFICATION_ENABLED=true
BLOCK_UNVERIFIED_LOGIN=true
OTP_PEPPER=change-me-min-8-chars
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

EMERGENCY_PHONE=
