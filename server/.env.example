NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────────────────────────
# Local Docker: mongodb://mongodb:27017/mentalhealth
# Atlas:        mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://mongodb:27017/mentalhealth

# ─── Auth secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_DAYS=30

# ─── OTP / Email verification ───────────────────────────────────────────────────
OTP_PEPPER=REPLACE_WITH_32_BYTE_HEX_SECRET
EMAIL_VERIFICATION_ENABLED=true
BLOCK_UNVERIFIED_LOGIN=true

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Email (Resend — server-only, never expose to mobile client) ─────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=System Administrator

# ─── CORS / Client ──────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:8081
# Browser Socket.IO origins (comma-separated). Falls back to CORS_ORIGINS when unset.
SOCKET_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Rate limits ────────────────────────────────────────────────────────────────
SOCKET_MESSAGE_RATE_LIMIT_WINDOW_MS=60000
SOCKET_MESSAGE_RATE_LIMIT_MAX=60
SOCKET_MAX_CONNECTIONS_PER_USER=3
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=5

# ─── Admin bootstrap ────────────────────────────────────────────────────────────
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# ─── Cloudinary (optional) ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payments (optional — leave empty locally to use dev mock checkout) ──────────
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_RETURN_URL=http://localhost:5000/payment-return
API_BASE_URL=http://localhost:5000

# ─── AI ─────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Misc ───────────────────────────────────────────────────────────────────────
EMERGENCY_PHONE=

# ─── WebRTC (optional) ──────────────────────────────────────────────────────────
WEBRTC_ENABLED=false
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
