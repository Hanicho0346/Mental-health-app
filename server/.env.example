NODE_ENV=development
PORT=4000
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dbname
JWT_SECRET=your_jwt_secret_min_16_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_16_chars
EMAIL_VERIFICATION_ENABLED=false
BLOCK_UNVERIFIED_LOGIN=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLERK_SECRET_KEY=sk_test_your_clerk_secret
MONGODB_URI=mongodb://127.0.0.1:27017/mentalhealth
# JWT_SECRET=change-me-min-16-chars-long
# JWT_REFRESH_SECRET=change-me-min-16-chars-long
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_DAYS=30
CORS_ORIGINS=http://localhost:8081
# When true, register stores a 6-digit OTP and emails it; client goes to /verify-email before login.
EMAIL_VERIFICATION_ENABLED=true
BLOCK_UNVERIFIED_LOGIN=true
# OTP_PEPPER=change-me-min-8-chars
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

EMERGENCY_PHONE=

# Clerk (required for Clerk session verification + user sync)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Comma-separated emails granted admin on Clerk sync (bootstrap)
ADMIN_BOOTSTRAP_EMAILS=admin@example.com

# Future WebRTC consultation (optional)
WEBRTC_ENABLED=false
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
